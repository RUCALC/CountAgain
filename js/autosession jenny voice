  },
  audio: [],
  show_detailed_errors: true,
  continue_after_error: true,
  on_error: (src) => console.error('Session1 fallback also failed for:', src),
  on_start: function() {
    if (failedSessionAssets.size > 0) {
      console.log(`Loading ${failedSessionAssets.size} session1 fallback assets...`);
    }
  },
  on_finish: function() {
    if (failedSessionAssets.size > 0) {
      console.log(`Session1 fallback complete. Setting up URL redirection for ${failedSessionAssets.size} assets.`);

      // Override the Image constructor to automatically redirect failed URLs to session1 versions
      const OriginalImage = window.Image;
      const descriptor = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
      const originalSetter = descriptor.set;

      window.Image = function(...args) {
        const img = new OriginalImage(...args);

        Object.defineProperty(img, 'src', {
          get: descriptor.get,
          set: function(value) {
            // Check if this URL failed and should use session1 fallback
            if (failedSessionAssets.has(value)) {
              const fallbackUrl = failedSessionAssets.get(value);
              console.log(`Redirecting ${value} -> ${fallbackUrl}`);
              originalSetter.call(this, fallbackUrl);
            } else {
              originalSetter.call(this, value);
            }
          },
          configurable: true,
          enumerable: true
        });

        return img;
      };

      // Preserve prototype chain
      Object.setPrototypeOf(window.Image, OriginalImage);
      Object.setPrototypeOf(window.Image.prototype, OriginalImage.prototype);
    }
  }
};

