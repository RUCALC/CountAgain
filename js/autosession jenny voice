        c.style.width=`${placement.widthPx}px`; c.style.height='auto'; c.style.filter='drop-shadow(0 2px 2px rgba(0,0,0,.30))';
        stage.appendChild(c); landedClones.push(c);
        penguin[idx].style.visibility='hidden';
        idx++; try{ const sfx=selectSFX(); sfx.currentTime=0; sfx.play().catch(()=>{});}catch{}
      }

      function resetAll(){
        landedClones.forEach(el=>el.remove()); landedClones=[];
        penguin.forEach(t=>{ t.style.visibility=''; t.style.position=''; t.style.left=''; t.style.top=''; t.style.zIndex=''; t.style.transform=''; t.style.transformOrigin=''; });
        idx=0;
      }

      function onKey(e){
        if(e.repeat) return;
        if(e.key===' '||e.code==='Space'){ e.preventDefault(); placeOne(); }
        else if(e.key==='r'||e.key==='R'){ resetAll(); }
        else if(e.key==='q'||e.key==='Q'){ document.removeEventListener('keydown', onKey); jsPsych.finishTrial({ placements: idx, game_tag: tag }); }
      }
      _onKey = onKey;
      document.addEventListener('keydown', onKey);
    },
    on_finish: function() {
      stopAudio();
      if (_onKey) { document.removeEventListener('keydown', _onKey); _onKey = null; }
    }
  };
}

