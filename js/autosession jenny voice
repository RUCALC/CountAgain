const DROP_PLACEMENT_DEFAULTS = {
  leftOverhangPx: 70,
  rightOverhangPx: 70,
  baselineCushionPx: -10
};

function getSpriteWidthPx(spriteEl, fallbackPx = 120) {
  const width = Math.round(spriteEl?.getBoundingClientRect?.().width || 0);
  return width > 0 ? width : fallbackPx;
}

function computeDropPlacement({
  landEl,
  spriteWidthPx,
  index,
  total,
  leftOverhangPx = DROP_PLACEMENT_DEFAULTS.leftOverhangPx,
  rightOverhangPx = DROP_PLACEMENT_DEFAULTS.rightOverhangPx,
  baselineCushionPx = DROP_PLACEMENT_DEFAULTS.baselineCushionPx
}) {
  const landRect = landEl.getBoundingClientRect();
  const widthPx = Math.max(1, Math.round(spriteWidthPx || 0));
  const leftEdge = landRect.left + widthPx / 2 - leftOverhangPx;
  const rightEdge = landRect.right - widthPx / 2 + rightOverhangPx;
  const frac = total <= 1 ? 0.5 : index / (total - 1);
  const centerX = leftEdge + frac * (rightEdge - leftEdge);
  const bottomPx = Math.round(window.innerHeight - landRect.bottom + baselineCushionPx);

  return {
    leftPx: Math.round(centerX - widthPx / 2),
    bottomPx,
    widthPx
  };
}


function cousinAudioTurtles(bg, audioURL, { tag = "cousin_UNTAGGED" } = {}) {
  let _onKey = null;  let idx = 0;
  return {
    type: jsPsychHtmlButtonResponse,
    stimulus: `
      <div id="stage" style="position:fixed; inset:0; background:#000; overflow:hidden;">
        <img id="bg" src="${bg}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:1;">

        <!-- FIXED-SIZE CONTAINER for the top-row turtles -->
        <div id="rowWrap"
             style="position:absolute; left:50%; transform:translateX(-50%); top:3.2vh;
                    width:min(96vw, 1400px); z-index:3;">
          <div id="row"
               style="display:flex; justify-content:space-between; align-items:center; gap:28px;"></div>
        </div>

        <div id="land" style="position:absolute; left:50%; transform:translateX(-50%);
             bottom:32vh; width:min(92vw, 1250px); height:14vh; z-index:2; background:transparent; border-radius:12px;"></div>

        <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
             z-index:5; font-size:18px; background:rgba(0,0,0,.55); color:#fff; padding:12px 16px; border-radius:10px; text-align:center;">
          press spacebar to move toy · trial will move on automatically for this part
        </div>
      </div>
    `,
    choices: [],
    trial_duration: 3000, //jenny added to constrain timing
    response_ends_trial: true,
    extensions: recExt,
    data: { game_tag: tag },
    on_load: function(){
        idx = 0;
      // ---- one-shot audio (no replay on clicks) ----
      stopAudio();
      const a = audio(); let started=false;
      const startOnce = ()=>{ if(started) return; a.src = audioURL; a.play().then(()=>started=true).catch(()=>{}); };
      startOnce();
      document.body.addEventListener('pointerdown', ()=>{ if(!started&&(a.paused||a.currentTime===0)) startOnce(); }, { once:true });

      const stage   = document.getElementById('stage');
      const rowWrap = document.getElementById('rowWrap');
      const row     = document.getElementById('row');
      const land    = document.getElementById('land');

      // ---- build turtles on the TOP ROW ----
      const N = 1, turtles = []; //--jenny edit: change to only 1 toy
      for (let i=0;i<N;i++){
        const t = document.createElement('img');
        t.src = TURT;
        // initial responsive width (we'll lock to pixels below)
        t.style.width  = 'min(9vw, 140px)';
        t.style.height = 'auto';
        t.style.filter = 'drop-shadow(0 2px 2px rgba(0,0,0,.30))';
        row.appendChild(t);
        turtles.push(t);
      }

      // ---- LOCK the container and turtle sizes (prevent resize-driven scaling) ----
      let TOP_W = null, LOCKED_WRAP_W = null;

      function lockRowSize() {
        // lock wrapper width in pixels (so space-between spacing stays fixed)
        const wr = rowWrap.getBoundingClientRect();
        LOCKED_WRAP_W = Math.round(wr.width);
        rowWrap.style.width = `${LOCKED_WRAP_W}px`;

        // measure the first turtle's pixel size and lock ALL turtles to that px width
        const r0 = turtles[0].getBoundingClientRect();
        TOP_W = Math.round(r0.width);
        turtles.forEach(t => { t.style.width = `${TOP_W}px`; t.style.height = 'auto'; });

        // also lock the visual height of rowWrap so it doesn't collapse/shift
        rowWrap.style.height = `${Math.max(1, Math.round(r0.height))}px`;
      }

      // lock after layout paints
      requestAnimationFrame(lockRowSize);

      requestAnimationFrame(lockRowSize);

      let landedClones = [];

      function placeOne(){
        if (idx >= N) return;

        const topWidthPx = TOP_W ?? getSpriteWidthPx(turtles[0]);
        const placement = computeDropPlacement({
          landEl: land,
          spriteWidthPx: topWidthPx,
          index: idx,
          total: N,
          baselineCushionPx: DROP_PLACEMENT_DEFAULTS.baselineCushionPx - 30
        });

        // create CLONE for landing; keep top-row turtle hidden to avoid afterimage
        const c = document.createElement('img');
        c.src = TURT;
        c.style.position = 'fixed';
        c.style.zIndex   = '4';
        c.style.left     = `${placement.leftPx}px`;
        c.style.bottom   = `${placement.bottomPx}px`;
        c.style.width    = `${placement.widthPx}px`;
        c.style.height   = 'auto';
        c.style.filter   = 'drop-shadow(0 2px 2px rgba(0,0,0,.30))';
        stage.appendChild(c);
        landedClones.push(c);

        turtles[idx].style.visibility = 'hidden';

        idx++;
        try{ const sfx=selectSFX(); sfx.currentTime=0; sfx.play().catch(()=>{});}catch{}
      }

      function resetAll(){
        // remove landing clones
        landedClones.forEach(el => el.remove());
        landedClones = [];
        // restore all top-row turtles (unchanged px size)
        turtles.forEach(t=>{
          t.style.visibility = '';
          t.style.position   = '';
          t.style.left       = '';
          t.style.top        = '';
          t.style.zIndex     = '';
          t.style.transform  = '';
          t.style.transformOrigin = '';
        });
        idx=0;
      }

      function onKey(e){
        if(e.repeat) return;
        if(e.key===' '||e.code==='Space'){ e.preventDefault(); placeOne(); }
        else if(e.key==='r'||e.key==='R'){ resetAll(); }
        else if(e.key==='q'||e.key==='Q'){ document.removeEventListener('keydown', onKey); jsPsych.finishTrial({ placements: idx, game_tag: tag }); }
      }
      _onKey = onKey;
      document.addEventListener('keydown', onKey);
    },
    on_finish: function() {
      stopAudio();
      jsPsych.data.addDataToLastTrial({ placements: idx, game_tag: tag });
      if (_onKey) { document.removeEventListener('keydown', _onKey); _onKey = null; }
    }
  };
}

