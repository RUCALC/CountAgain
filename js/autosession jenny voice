function imageButton(src, alt, onClick, w='270px'){
  const b=document.createElement('button');
  b.style.border='none'; b.style.background='transparent'; b.style.padding='0'; b.style.margin='0'; b.style.cursor='pointer';
  const i=document.createElement('img'); i.src=src; i.alt=alt||''; i.style.maxWidth='22vw'; i.style.width=w;
