function audioImageWithNext(imgURL, audioURL, {btn=NEXT_BTN, btnPos, postDelayMs=0, record=true, tag=null, text=null}={}){
  return {
    type: jsPsychHtmlButtonResponse,
    stimulus: fullImageScaffold(imgURL, { pos: btnPos, text: text }),
    choices: [],
    data: { trial_tag: tag },
    extensions: record ? recExt : undefined,
    on_load: function(){
      stopAudio();
      const slot = document.getElementById('btn-slot');
      const showBtn = () => {
        if (!slot.querySelector('button')) {
          const el = imageButton(btn, 'Next', ()=> jsPsych.finishTrial());
          if (postDelayMs>0){ el.style.display='none'; slot.appendChild(el); setTimeout(()=>el.style.display='inline-block', postDelayMs); }
          else { slot.appendChild(el); }
        }
      };
      const a = audio();
      a.onended = showBtn; a.onerror = showBtn;
      const safety = setTimeout(showBtn, AUDIO_TIMEOUT);
      let __srcSet=false; const tryPlay = () => { if(!__srcSet){ a.src=audioURL; __srcSet=true; } a.play().then(()=>clearTimeout(safety)).catch(()=>{}); };
      tryPlay();
      const unlock = () => { if(a.paused) tryPlay(); document.body.removeEventListener('pointerdown', unlock); };
      document.body.addEventListener('pointerdown', unlock, { once:true });
    },
    on_finish: stopAudio
  };
}

