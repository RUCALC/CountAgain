function fullImageScaffold(imgURL, opts={}){
  const pos = opts.pos || 'right:24px; bottom:24px;';
  const bg = opts.bg || '#000';
  const extraImg = opts.imgStyle || '';
  const text = opts.text || '';
  const textOverlay = text ? `<div style="position:absolute; top:20px; left:50%; transform:translateX(-50%); z-index:10; background:rgba(0,0,0,.65); color:#fff; padding:14px 20px; border-radius:10px; font-size:clamp(16px, 1.9vw, 22px); text-align:center; max-width:90%;">${text}</div>` : '';
  return `
    <div style="position:fixed; inset:0; background:${bg}; overflow:hidden;">
      <img src="${imgURL}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; ${extraImg}">
      ${textOverlay}
      <div id="btn-slot" style="position:absolute; ${pos}"></div>
    </div>
  `;
}

