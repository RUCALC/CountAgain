const survey_trial = {
  type: jsPsychSurveyMultiChoice,
  questions: [
    {
      prompt: "Where should you be during the study?",
      name: "locationResponse",
      options: [
        "In the kitchen making food.",
        "Sitting next to your child and help them understand the instructions.",
        "Going to get some blueberries from the store.",
      ],
      required: true,
    },
    {
      prompt: "Which of these can you say after your child answers a question?",
      name: "postChildResponse",
      options: ["Okay!", "Hmm, I don't think so.", "Are you sure?"],
      required: true,
    },
    {
      prompt: "What should you do if your child is distracted during a question?",
      name: "childDistractionResponse",
      options: [
        "Quit the study.",
        "Encourage them to keep watching and listening. You can also pause the study.",
        "Give them a hint.",
      ],
      required: true,
    },
    {
      prompt: "Is it ok to stop the study early?",
      name: "withdrawal",
      options: [
        "No, I must complete the full study.",
        "Yes, I can press F1 or ctrl-X or close the tab at any time.",
      ],
      required: true,
    },
  ],

  on_load: function () {
    // Correct option indices by question order (0-based)
    const correctByQuestionIndex = [1, 0, 1, 1];

    const questionDivs = Array.from(
      document.querySelectorAll(".jspsych-survey-multi-choice-question")
    );

    const continueBtn =
      document.querySelector("#jspsych-survey-multi-choice-next") ||
      document.querySelector("input[type='submit']") ||
      document.querySelector("button[type='submit']");

    if (!continueBtn) {
      console.error("Continue button not found.");
      return;
    }

    function setFeedback(questionEl, msg) {
      let fb = questionEl.querySelector(".custom-answer-feedback");
      if (!fb) {
        fb = document.createElement("div");
        fb.className = "custom-answer-feedback";
        fb.style.color = "red";
        fb.style.marginTop = "6px";
        fb.style.fontSize = "0.95em";
        questionEl.appendChild(fb);
      }
      fb.textContent = msg;
    }

    function clearFeedback(questionEl) {
      const fb = questionEl.querySelector(".custom-answer-feedback");
      if (fb) fb.remove();
    }

    // Clear feedback when user changes any answer in a question
    questionDivs.forEach((qDiv) => {
      qDiv.addEventListener("change", () => clearFeedback(qDiv));
    });

    // Intercept before jsPsych handles the button
    continueBtn.addEventListener(
      "click",
      function (e) {
        let hasWrong = false;

        questionDivs.forEach(clearFeedback);

        questionDivs.forEach((qDiv, qIndex) => {
          // Find all radio inputs for THIS question block
          const radios = Array.from(qDiv.querySelectorAll("input[type='radio']"));
          const checkedIndex = radios.findIndex((r) => r.checked);

          // If unanswered, let jsPsych required logic handle it
          if (checkedIndex === -1) return;

          if (checkedIndex !== correctByQuestionIndex[qIndex]) {
            hasWrong = true;
            setFeedback(qDiv, "Try selecting a different answer above!");
          }
        });

        if (hasWrong) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          return false;
        }
      },
      true
    );
  },
};
