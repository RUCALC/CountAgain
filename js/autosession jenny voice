function imagePressQ(imgURL, {promptText='press q to finish', bottomRight=true, showAfterMs=0, record=true, tag=null}={}) {
  let _onKey = null;
  return {
    type: jsPsychHtmlButtonResponse,
    stimulus: fullImageScaffold(imgURL),
    choices: [],
    data: { trial_tag: tag },
    extensions: record ? recExt : undefined,
    on_load: function () {
      // ensure absolutely no audio on this page
      stopAudio();

      let shown = false;
      const showPrompt = () => {
        if (shown) return; shown = true;
        const overlay = document.createElement('div');
        overlay.style.cssText = `position:absolute; ${bottomRight ? 'right:2.2vw; bottom:2.2vh;' : 'left:50%; top:50%; transform:translate(-50%,-50%);'} z-index:5; background:rgba(0,0,0,.55); color:#fff; padding:10px 14px; border-radius:10px; font-size:clamp(14px,1.8vw,20px);`;
        overlay.textContent = promptText;
        jsPsych.getDisplayElement().querySelector('div').appendChild(overlay);
        function onKey(e){ if(e.repeat) return; if(e.key==='q'||e.key==='Q'){ document.removeEventListener('keydown', onKey); jsPsych.finishTrial(); } }
        _onKey = onKey;
        document.addEventListener('keydown', onKey);
      };
      if (showAfterMs > 0) jsPsych.pluginAPI.setTimeout(showPrompt, showAfterMs); else showPrompt();
    },
    on_finish: function() {
      if (_onKey) { document.removeEventListener('keydown', _onKey); _onKey = null; }
    }
  };
}


