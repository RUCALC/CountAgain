function getForcedStudySessionNumber() {
  const fromWindow = Number(window.__FORCE_STUDY_SESSION__);
  if (Number.isInteger(fromWindow) && fromWindow >= 1) return fromWindow;

  try {
    const fromStorage = Number(window.localStorage?.getItem('forceStudySession'));
    if (Number.isInteger(fromStorage) && fromStorage >= 1) return fromStorage;
  } catch {}

  try {
    const fromQuery = Number(new URLSearchParams(window.location.search).get('forceSession'));
    if (Number.isInteger(fromQuery) && fromQuery >= 1) return fromQuery;
  } catch {}

  return null;
}

function getCurrentStudySessionNumber() {
  const forced = getForcedStudySessionNumber();
  if (forced !== null) {
    console.warn(`Using forced study session: ${forced}`);
    return forced;
  }

  const pastSessions = window.chs?.pastSessions;
  if (Array.isArray(pastSessions)) {
    return Math.max(1, pastSessions.length + 1);
  }
  return 1;
}

const CURRENT_STUDY_SESSION = getCurrentStudySessionNumber();

// Dev helpers for forcing session in browser console.
// force a specific session number using ?forceSession=X in url OR
//window.setStudySessionForDebug(X); and then location.reload();

window.setStudySessionForDebug = function(sessionNumber) {
  const n = Number(sessionNumber);
  if (!Number.isInteger(n) || n < 1) {
    console.error('setStudySessionForDebug expects an integer >= 1');
    return;
  }
  window.__FORCE_STUDY_SESSION__ = n;
  try { window.localStorage?.setItem('forceStudySession', String(n)); } catch {}
  console.log(`Forced study session set to ${n}. Reload to apply.`);
};

window.clearStudySessionDebugOverride = function() {
  try { window.localStorage?.removeItem('forceStudySession'); } catch {}
  delete window.__FORCE_STUDY_SESSION__;
  console.log('Cleared forced study session override. Reload to apply.');
};

function withCurrentSessionAsset(url) {
  return url.replace(/\/session\d+\//, `/session${CURRENT_STUDY_SESSION}/`);
}

// Helper to get session1 version of a URL
function getSession1Asset(url) {
  return url.replace(/\/session\d+\//, '/session1/');
}

