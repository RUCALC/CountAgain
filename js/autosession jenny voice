function imageWithTimedNext(
  imgURL,
  delayMs = 15000,
  { btn = NEXT_BTN, btnPos = 'right:24px; bottom:24px;', record = true, tag = null } = {}
) {
  // closure variable shared by on_load + on_finish
  let timedNextCleanup = null;

  return {
    type: jsPsychHtmlKeyboardResponse,
    stimulus: fullImageScaffold(imgURL, { pos: btnPos }),
    choices: "NO_KEYS",
    data: { trial_tag: tag },
    extensions: record ? recExt : undefined,

    on_load: function () {
      const forceSilent = () => {
        try {
          stopAudio?.();
          const a = audio?.();
          if (a) {
            a.pause?.();
            a.currentTime = 0;
            a.onended = null;
            a.onerror = null;
            // DO NOT set a.src = "" (causes Invalid URI in some browsers)
            a.removeAttribute?.("src");
            // a.load?.(); // optional; only if you need to reset media element
          }
        } catch (err) {
          console.warn("forceSilent error:", err);
        }
      };

      forceSilent();

      const displayEl =
        (typeof jsPsych.getDisplayElement === "function" && jsPsych.getDisplayElement()) ||
        document.body;

      const slot = document.getElementById("btn-slot");
      if (!slot) {
        console.error("imageWithTimedNext: #btn-slot not found");
        return;
      }

      let nextEnabled = false;
      let finished = false;

      const nextBtn = imageButton(btn, "Next", () => {});
      nextBtn.classList.add("timed-next-btn");
      nextBtn.style.display = "none";
      nextBtn.style.position = "relative";
      nextBtn.style.zIndex = "10001";
      slot.appendChild(nextBtn);

      // Shield overlay blocks ALL pointer/touch until timer ends
      const shield = document.createElement("div");
      shield.id = "timed-next-shield";
      shield.style.position = "fixed";
      shield.style.inset = "0";
      shield.style.background = "transparent";
      shield.style.zIndex = "10000";
      shield.style.pointerEvents = "auto";

      const swallow = (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation?.();
        forceSilent();
        return false;
      };

      const shieldEvents = [
        "click",
        "dblclick",
        "mousedown",
        "mouseup",
        "pointerdown",
        "pointerup",
        "touchstart",
        "touchend",
        "contextmenu",
      ];
      shieldEvents.forEach((evt) => shield.addEventListener(evt, swallow, true));
      displayEl.appendChild(shield);

      // Block all keyboard (prevents space/enter/global handlers/audio unlock)
      const blockKeys = (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation?.();
        forceSilent();
        return false;
      };
      document.addEventListener("keydown", blockKeys, true);
      document.addEventListener("keyup", blockKeys, true);
      document.addEventListener("keypress", blockKeys, true);

      // Optional extra safety: keep audio dead while this screen is active
      const silenceInterval = setInterval(forceSilent, 250);

      const cleanup = () => {
        clearInterval(silenceInterval);
        document.removeEventListener("keydown", blockKeys, true);
        document.removeEventListener("keyup", blockKeys, true);
        document.removeEventListener("keypress", blockKeys, true);
        try { shield.remove(); } catch {}
      };

      const finishNow = (e) => {
        if (!nextEnabled || finished) {
          e?.preventDefault?.();
          e?.stopPropagation?.();
          e?.stopImmediatePropagation?.();
          forceSilent();
          return false;
        }

        finished = true;
        e?.preventDefault?.();
        e?.stopPropagation?.();
        e?.stopImmediatePropagation?.();

        forceSilent();
        clearTimeout(timerId);
        cleanup();

        // defer one tick to avoid event-stack conflicts
        setTimeout(() => {
          jsPsych.finishTrial({ timed_next_clicked: true });
        }, 0);

        return false;
      };

      // Delegate click handling on slot; works for nested img/span inside imageButton
      const slotClickHandler = (e) => {
        if (!nextEnabled) return;

        const target =
          e.target && e.target.nodeType === 3 ? e.target.parentElement : e.target;

        const insideNext = !!target?.closest?.(".timed-next-btn");
        if (insideNext) {
          finishNow(e);
        }
      };

      slot.addEventListener("click", slotClickHandler, true);
      slot.addEventListener("pointerup", slotClickHandler, true);
      slot.addEventListener("touchend", slotClickHandler, true);

      const timerId = setTimeout(() => {
        nextEnabled = true;
        try { shield.remove(); } catch {}
        nextBtn.style.display = "inline-block";
        forceSilent();
      }, delayMs);

      // store cleanup in closure, NOT on `this`
      timedNextCleanup = () => {
        clearTimeout(timerId);
        slot.removeEventListener("click", slotClickHandler, true);
        slot.removeEventListener("pointerup", slotClickHandler, true);
        slot.removeEventListener("touchend", slotClickHandler, true);
        cleanup();
      };
    },

    on_finish: function () {
      try {
        if (typeof timedNextCleanup === "function") timedNextCleanup();
      } catch (err) {
        console.warn("timedNextCleanup error:", err);
      }
    }
  };
}

