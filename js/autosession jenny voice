// Wrap a practice trial with feedback + repeat-on-error
function goNoGoPracticeWithFeedback({ bg, expectPress, tag, msgCorrect, msgIncorrect, audioCorrect, audioWrong }) {
  const trial = goNoGoPracticeTrial(bg, expectPress, { tag });

  const feedbackCorrect = readyInstructionAudio(`<h3>${msgCorrect}</h3>`, audioCorrect);
  const feedbackIncorrect = readyInstructionAudio(`<h3>${msgIncorrect}</h3>`, audioWrong);

  return {
    timeline: [
      trial,
      {
        timeline: [ feedbackCorrect ],
        conditional_function: () => lastPracticeCorrect(tag) === true
      },
      {
        timeline: [ feedbackIncorrect ],
        conditional_function: () => lastPracticeCorrect(tag) === false
      }
    ],
    loop_function: () => lastPracticeCorrect(tag) === false
  };
}

